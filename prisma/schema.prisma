generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  role      String
  createdAt DateTime @default(now())
}

model Project {

  id        Int      @id @default(autoincrement())

  name      String

  schema    String

  createdAt DateTime @default(now())
}